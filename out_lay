import graphviz

def create_pipeline_diagram(pipeline_steps, filename="pipeline_diagram"):
    """
    Creates a directed graph representing a pipeline.

    Args:
        pipeline_steps: A list of dictionaries, where each dictionary
                        has 'name' and optionally 'label' keys.
        filename: The name of the output file.
    """
    dot = graphviz.Digraph(comment='Genome Assembly Pipeline', filename=filename, format='png')
    dot.attr('node', shape='box', style='rounded')  # Set node attributes

    for step in pipeline_steps:
        node_name = step['name']
        node_label = step.get('label', node_name)  # Use label if provided, otherwise use name
        dot.node(node_name, label=node_label)

    # Add edges (arrows) based on the order of steps
    for i in range(len(pipeline_steps) - 1):
        dot.edge(pipeline_steps[i]['name'], pipeline_steps[i+1]['name'])

    dot.render(cleanup=True)  # Render to a file (e.g., PNG) and cleanup

